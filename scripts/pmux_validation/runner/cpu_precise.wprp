<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="PMUX independent validation">
  <Profiles>
    <SystemCollector Id="PMUXSystem" Name="PMUX CPU precise collector">
      <BufferSize Value="256"/><Buffers Value="128"/>
    </SystemCollector>
    <SystemProvider Id="PMUXEvents">
      <Keywords><Keyword Value="ProcessThread"/><Keyword Value="CSwitch"/>
        <Keyword Value="DPC"/><Keyword Value="Interrupt"/></Keywords>
    </SystemProvider>
    <Profile Id="PMUXCPU.Verbose.File" Name="PMUXCPU" Description="Process/thread lifetime and precise CPU; no sampling or stacks" LoggingMode="File" DetailLevel="Verbose">
      <Collectors><SystemCollectorId Value="PMUXSystem"><SystemProviderId Value="PMUXEvents"/></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
