<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="PMUX independent diagnostics">
  <Profiles>
    <SystemCollector Id="PMUXSystem" Name="PMUX test4 diagnostic collector">
      <BufferSize Value="256"/><Buffers Value="256"/>
    </SystemCollector>
    <SystemProvider Id="PMUXEvents">
      <Keywords>
        <Keyword Value="ProcessThread"/><Keyword Value="Loader"/>
        <Keyword Value="CSwitch"/><Keyword Value="ReadyThread"/>
        <Keyword Value="SampledProfile"/><Keyword Value="DPC"/><Keyword Value="Interrupt"/>
        <Keyword Value="FileIO"/><Keyword Value="FileIOInit"/>
        <Keyword Value="HardFaults"/><Keyword Value="AllFaults"/>
      </Keywords>
      <Stacks><Stack Value="SampledProfile"/><Stack Value="CSwitch"/><Stack Value="ReadyThread"/></Stacks>
    </SystemProvider>
    <Profile Id="PMUXCPU.Verbose.File" Name="PMUXCPU" Description="Diagnostic sampled CPU, scheduling, loading, file reads and faults" LoggingMode="File" DetailLevel="Verbose">
      <Collectors><SystemCollectorId Value="PMUXSystem"><SystemProviderId Value="PMUXEvents"/></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
