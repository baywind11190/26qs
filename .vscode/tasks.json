{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "V8只读预检",
            "type": "process",
            "command": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/d",
                "/c",
                "${workspaceFolder}\\scripts\\pmux_validation\\validate_windows_v8.cmd",
                "plan",
                "${input:algorithmCommit}",
                "--integration-profile",
                "${input:integrationProfile}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "algorithmCommit",
            "type": "promptString",
            "description": "算法完整40位Git提交（不使用分支名或SHA-256）",
            "default": "17f9361099dcda757c16bb81caa18ddb52d74c4e"
        },
        {
            "id": "integrationProfile",
            "type": "pickString",
            "description": "目标含已登记7.1局部LUT补丁时必须选择p3-local-lut",
            "options": ["p3", "p3-local-lut"],
            "default": "p3-local-lut"
        }
    ]
}
